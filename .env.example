# =====================================================================
# DeepCrips Hub — Environment Variables
# =====================================================================
# Salin file ini menjadi `.env.local` lalu isi nilainya.
# JANGAN pernah menaruh nilai rahasia di file yang di-commit ke Git.
# JANGAN pernah menaruh SERVICE ROLE KEY di variabel yang diawali
# NEXT_PUBLIC_ — variabel NEXT_PUBLIC ter-embed ke bundle browser.

# ---------------------------------------------------------------------
# Supabase (wajib)
# Ditemukan di: Supabase Dashboard → Project Settings → API
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ---------------------------------------------------------------------
# Supabase SERVICE ROLE KEY (rahasia — HANYA di server, JANGAN di NEXT_PUBLIC_)
# Ditemukan di: Supabase Dashboard → Project Settings → API → service_role
# Dibutuhkan untuk: resolve URL host download + tulis audit log.
# Bila kosong, fitur download akan mengembalikan 503 (jujur, bukan data palsu).
# ---------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------
# URL publik situs (wajib untuk OAuth redirect & metadata SEO)
# Saat development biarkan default http://localhost:3000
# ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------
# YouTube (opsional)
# Channel handle untuk link komunitas & footer. Kosongkan jika tidak ada.
# ---------------------------------------------------------------------
NEXT_PUBLIC_YOUTUBE_HANDLE=DeepCrips
